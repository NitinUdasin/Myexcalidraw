    {
      "id": "yMzRMGva8q41LKUf2vd9d",
      "type": "text",
      "x": 5719.997585716449,
      "y": 1468.765196723124,
      "width": 1046.305742288686,
      "height": 21.696788736850422,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FC1oDr4QurPKLRlwD_Cen"
      ],
      "frameId": null,
      "index": "bMK",
      "roundness": null,
      "seed": 479299117,
      "version": 404,
      "versionNonce": 484132195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779557815010,
      "link": null,
      "locked": false,
      "text": "Dense vector : An array of numerical values (usually floating-point numbers) where most or all elements hold non-zero values",
      "fontSize": 17.357430989480342,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dense vector : An array of numerical values (usually floating-point numbers) where most or all elements hold non-zero values",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2DFk5NvrLJJu2JeLdRyfL",
      "type": "text",
      "x": 5720.3626388029625,
      "y": 1365.1027700551049,
      "width": 1222.1710692181439,
      "height": 21.696788736850422,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FC1oDr4QurPKLRlwD_Cen"
      ],
      "frameId": null,
      "index": "bML",
      "roundness": null,
      "seed": 1178220685,
      "version": 151,
      "versionNonce": 11706627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779557815010,
      "link": null,
      "locked": false,
      "text": "Frequency-Based : These are the earliest, classical methods. They do not capture semantic meaning but are highly reliable for keyword matching",
      "fontSize": 17.357430989480335,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frequency-Based : These are the earliest, classical methods. They do not capture semantic meaning but are highly reliable for keyword matching",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GLIzpDTyF-34-vi-H1TBq",
      "type": "text",
      "x": 5723.779022886141,
      "y": 1402.6760659012111,
      "width": 1816.3506242492133,
      "height": 21.696788736850422,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "FC1oDr4QurPKLRlwD_Cen"
      ],
      "frameId": null,
      "index": "bMM",
      "roundness": null,
      "seed": 1893572333,
      "version": 210,
      "versionNonce": 341674147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779557815010,
      "link": null,
      "locked": false,
      "text": "Static Word Vectors : Introduced around 2013, these models learn to map words to a fixed-size vector space based on the distributional hypothesis (\"words that appear in similar contexts share similar meanings\").",
      "fontSize": 17.35743098948034,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Static Word Vectors : Introduced around 2013, these models learn to map words to a fixed-size vector space based on the distributional hypothesis (\"words that appear in similar contexts share similar meanings\").",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
