      "isDeleted": true,
      "boundElements": [],
      "updated": 1782372637986,
      "link": null,
      "locked": false,
      "text": "Immediate feedback creates a tight cause-effect loop: action taken, result known, correction made — instantly.\nThis loop keeps consciousness anchored in the now, with no gap for the mind to drift.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Immediate feedback creates a tight cause-effect loop: action taken, result known, correction made — instantly.\nThis loop keeps consciousness anchored in the now, with no gap for the mind to drift.",
      "autoResize": true,
      "lineHeight": 1.25
    },
