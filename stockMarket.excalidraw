      "text": "2 — Merger of Action & Awareness",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "AdlD2yvehc5-QPA6Xeyb0",
      "originalText": "2 — Merger of Action & Awareness",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nG0AMLgV96LWi1M4-RiJW",
      "type": "text",
      "x": -4929.427575857606,
      "y": 3950.062724851672,
      "width": 283.7098388671875,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1a4d2e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kjxEFhKEIXxH36Npup36R"
      ],
      "frameId": null,
      "index": "bAd7",
      "roundness": null,
      "seed": 336335637,
      "version": 463,
      "versionNonce": 957659722,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782372637986,
      "link": null,
      "locked": false,
      "text": "The outside observer disappears.\nDoing and being become one —\nno separation between self and action.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The outside observer disappears.\nDoing and being become one —\nno separation between self and action.",
      "autoResize": true,
      "lineHeight": 1.25
    },
