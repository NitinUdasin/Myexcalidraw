      "versionNonce": 2019812554,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782372637986,
      "link": null,
      "locked": false,
      "text": "Focus narrows to a limited field\nof information. All irrelevant\nthoughts and distractions drop away.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Focus narrows to a limited field\nof information. All irrelevant\nthoughts and distractions drop away.",
      "autoResize": true,
      "lineHeight": 1.25
