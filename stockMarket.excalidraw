      ],
      "frameId": null,
      "index": "bAd9V",
      "roundness": null,
      "seed": 1736663189,
      "version": 463,
      "versionNonce": 1622028234,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782372637986,
      "link": null,
      "locked": false,
      "text": "The inner critic goes silent.\nSelf-consciousness fades completely.\nEgo dissolves into the activity.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The inner critic goes silent.\nSelf-consciousness fades completely.\nEgo dissolves into the activity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
