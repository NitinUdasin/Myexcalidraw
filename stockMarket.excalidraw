      "text": "1 — Complete Concentration",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "u-d_Gseg7T5VqJ--1XN-X",
      "originalText": "1 — Complete Concentration",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
