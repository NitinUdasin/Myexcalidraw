      "text": "3 — Loss of Self",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mgjGSxYjz5wtSqfsZr3QD",
      "originalText": "3 — Loss of Self",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "M8ngVkLAK3BqusziZP4Rt",
      "type": "text",
      "x": -4559.427575857606,
      "y": 3950.062724851672,
      "width": 266.9397888183594,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#2d1b69",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
